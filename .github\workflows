name: Build OpenWrt x86-64

on:
  workflow_dispatch:
    inputs:
      openwrt_ref:
        description: "OpenWrt tag/branch"
        required: true
        default: "v25.12.5"
      clean_build:
        description: "Clean build"
        required: true
        type: boolean
        default: true
  push:
    branches: [main]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-24.04
    env:
      OPENWRT_REPO: https://github.com/openwrt/openwrt.git
      OPENWRT_REF: ${{ inputs.openwrt_ref || 'v25.12.5' }}

    steps:
      - name: Checkout builder repository
        uses: actions/checkout@v4

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential clang flex bison gawk gettext git \
            libncurses-dev libssl-dev python3 python3-distutils \
            rsync unzip file wget curl ccache subversion swig time \
            xsltproc libelf-dev device-tree-compiler qemu-utils zstd \
            python3-setuptools

      - name: Clone official OpenWrt source
        run: |
          git clone --depth=1 --branch="${OPENWRT_REF}" \
            "${OPENWRT_REPO}" openwrt
          cd openwrt
          git describe --tags --always

      - name: Install feeds
        working-directory: openwrt
        run: |
          cp ../feeds.conf.default ./feeds.conf.default
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Install PassWall feeds
        working-directory: openwrt
        run: |
          ./scripts/feeds update passwall_packages passwall_luci
          ./scripts/feeds install -p passwall_packages -a
          ./scripts/feeds install -p passwall_luci -a

      - name: Copy custom files and config
        run: |
          cp ../configs/x86-64.config openwrt/.config
          cp -a ../files openwrt/files
          cp -a ../scripts openwrt/custom-scripts
          chmod +x openwrt/custom-scripts/*.sh

      - name: Validate and normalize configuration
        working-directory: openwrt
        run: |
          ./custom-scripts/prepare.sh
          make defconfig

      - name: Show important configuration
        working-directory: openwrt
        run: |
          echo "=== TARGET ==="
          grep '^CONFIG_TARGET_' .config || true
          echo "=== IMAGE ==="
          grep -E 'CONFIG_TARGET_ROOTFS_EXT4FS|CONFIG_TARGET_IMAGES_GZIP|CONFIG_GRUB' .config || true
          echo "=== SELECTED PACKAGES ==="
          grep -E 'CONFIG_PACKAGE_(luci|luci-theme-argon|luci-app-passwall|xray-core|sing-box|qbittorrent|adguardhome|smartdns|dockerd|docker|docker-compose|mwan3)' .config || true

      - name: Download package sources
        working-directory: openwrt
        run: make download -j"$(nproc)" V=s

      - name: Compile
        working-directory: openwrt
        run: |
          if [ "${{ inputs.clean_build }}" = "true" ]; then
            make -j"$(nproc)" V=s
          else
            make -j"$(nproc)" V=s
          fi

      - name: Collect BIOS EXT4 combined image only
        run: |
          set -e
          mkdir -p release
          found=0
          for f in openwrt/bin/targets/x86/64/*ext4-combined*.img.gz; do
            [ -e "$f" ] || continue
            case "$f" in
              *efi*) continue ;;
            esac
            cp "$f" release/
            found=1
          done
          test "$found" = "1"
          cp openwrt/.config release/openwrt-x86-64.config
          cp openwrt/bin/targets/x86/64/sha256sums release/upstream-sha256sums.txt 2>/dev/null || true
          {
            echo "OpenWrt ref: ${OPENWRT_REF}"
            echo "Target: x86/64"
            echo "Profile: generic"
            echo "Filesystem: ext4-combined"
            echo "EFI: disabled"
            echo "Build UTC: $(date -u '+%Y-%m-%d %H:%M:%S')"
            echo
            echo "Selected services:"
            echo "LuCI + zh-cn + Argon"
            echo "PassWall + Xray + sing-box"
            echo "qBittorrent-nox"
            echo "DDNS"
            echo "AdGuardHome (userspace)"
            echo "SmartDNS"
            echo "Docker + Docker Compose"
            echo "mwan3"
            echo "USB Wi-Fi / USB storage"
          } > release/build-info.txt
          cd release
          sha256sum *.img.gz > sha256sums.txt
          ls -lh

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: openwrt-x86-64-ext4-combined
          path: release/

      - name: Create GitHub Release
        if: github.event_name == 'workflow_dispatch'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: custom-${{ env.OPENWRT_REF }}-${{ github.run_number }}
          name: OpenWrt x86-64 Custom ${{ env.OPENWRT_REF }} #${{ github.run_number }}
          generate_release_notes: true
          files: release/*

